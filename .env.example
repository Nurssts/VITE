# VITE environment variables. Server environment ONLY — never commit real values,
# never put keys into the frontend.

# ── Frontend (build time) ──
# VITE_API_URL=            (empty = same origin, as on Render)

# ── Official data (optional) ──
# FTC_API_USERNAME=
# FTC_API_TOKEN=
# TOA_API_KEY=

# ── VITE AI Engine (set at least one provider; all optional) ──
# AI_ENABLED=true                     # false = every AI feature off, the rest of VITE keeps working
# AI_PROVIDERS=gemini,anthropic,openai  # preference order; the next one is used if one fails

# Google Gemini (free tier available; free-tier prompts may be used by Google to improve products)
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite    # cheaper: gemini-3.1-flash-lite

# Anthropic Claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5       # lowest cost: claude-haiku-5-5
# ANTHROPIC_EFFORT=medium               # low | medium | high

# Any OpenAI-compatible API: OpenAI, DeepSeek, Qwen (DashScope), Groq, OpenRouter, local Ollama
# AI_OPENAI_BASE_URL=http://127.0.0.1:11434/v1   # e.g. https://api.deepseek.com, https://api.groq.com/openai/v1
# AI_OPENAI_API_KEY=
# AI_OPENAI_MODEL=qwen3:8b                       # e.g. deepseek-flash, openai/gpt-oss-20b, gpt-5.4-mini

# Cost and abuse limits
# AI_DAILY_LIMIT=400            # model turns per day, whole server
# AI_DAILY_TOKEN_LIMIT=3000000  # input+output tokens per day, whole server
# AI_MAX_OUTPUT_TOKENS=4096     # per model turn (Claude gets at least 8000)
# AI_TIMEOUT=90                 # seconds per model turn

# ── Other ──
# CORS_ORIGINS=                 # extra origins if the frontend is hosted separately
# LOG_LEVEL=INFO
